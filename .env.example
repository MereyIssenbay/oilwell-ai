# Phase 8: this root template is not loaded automatically.
# Export DATABASE_URL, MODEL_ARTIFACT_DIR and MAX_* settings into the API process.
# run_backend.py also reads ignored local runtime.json; its port is a CLI argument.
# Never commit a populated .env or print database credentials.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8001
# API_HOST/API_PORT above document local defaults; launcher uses --port 8001.
# Frontend uses same-origin /api. frontend/vite.config.ts proxies to 127.0.0.1:8001.
# No VITE_API_BASE_URL or public CORS configuration is consumed.

# Populate locally. No credentials or working connection string are provided.
POSTGRES_DB=oilwell_ai
POSTGRES_USER=oilwell_ai
POSTGRES_PASSWORD=
DATABASE_URL=

# Immutable source pin; obtaining telemetry requires Phase 1 approval.
DATASET_REPOSITORY=https://github.com/petrobras/3W
DATASET_REVISION=914af287b1cf3e5207dce0da1e9dc08361c9adeb
DATASET_VERSION=2.0.0
DATA_ROOT=./data
MODEL_ARTIFACT_DIR=./ml/artifacts/phase5/c4e1835a82620306778a
# Model version and threshold come from the immutable bundle, not overrides.
MAX_REQUEST_BYTES=262144
MAX_CONCURRENT_PREDICTIONS=4

# Replay values below document fixed runtime bounds, not environment overrides.
REPLAY_MAX_ACTIVE_SESSIONS=1
REPLAY_DEFAULT_SPEED=1
REPLAY_MAX_SPEED=20

# Future provider placeholders only. The LLM copilot and fallback are not implemented.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
RAG_ENABLED=false
