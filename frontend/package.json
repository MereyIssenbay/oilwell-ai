{
  "name": "oilwell-ai-dashboard",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "generate:api": "openapi-typescript ../docs/openapi.json -o src/api/generated.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "plotly.js-basic-dist-min": "4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/plotly.js": "3.0.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
